<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ajaxjs</groupId>
        <artifactId>aj-project-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>db-helper</artifactId>
    <version>1.0-SNAPSHOT</version>
    <description></description>

    <properties>
        <!-- 这里是项目主类运行入口 -->
        <project.mainClass>com.ajaxjs.dbhelper</project.mainClass>
    </properties>


    <build>
        <plugins>
            <!--一键部署到服务器 SSH-->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>wagon-maven-plugin</artifactId>
                <version>2.0.2</version>

                <executions>
                    <execution>
                        <id>upload-deploy</id>
                        <!-- 运行 install 打包的同时运行 upload-single和sshexec -->
                        <phase>install</phase>
                        <goals>
                            <goal>upload-single</goal>
                            <goal>sshexec</goal>
                        </goals>
                        <configuration>
                            <!-- 指定 SSH 账号 -->
                            <serverId>test.ajaxjs.com</serverId>
                            <!-- 要更新的 jar 包 -->
                            <fromFile>target/robot.jar</fromFile>
                            <!-- 服务器部署位置 -->
                            <url>scp://test.ajaxjs.com/home/service/robot</url>
                            <!-- 重启脚本 先切换目录，才能正确执行脚本 -->
                            <commands>
                                <command>cd /home/service/robot;./startup-deploy.sh</command>
                            </commands>
                            <!-- 显示运行命令的输出结果 -->
                            <displayCommandOutputs>true</displayCommandOutputs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- 保持现有驱动版本，避免未经兼容性验证的跨版本升级。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.ajaxjs</groupId>
            <artifactId>aj-iam-client</artifactId>
            <version>1.2</version>
        </dependency>

        <!-- Spring Boot Test Starter 通常会引入 JUnit，但我们可以覆盖其版本 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
