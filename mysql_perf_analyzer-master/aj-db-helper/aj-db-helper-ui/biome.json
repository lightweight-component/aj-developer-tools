{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedImports": "off",
        "noUnusedVariables": "off",
        "noUnusedFunctionParameters": "off",
        "noVueDuplicateKeys": "off"
      }
    }
  }
}
